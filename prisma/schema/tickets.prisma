enum Category {
  HARDWARE
  SOFTWARE
  ACCESS
  COGNITI
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  ON_HOLD
  RESOLVED
  CLOSED
  CANCELLED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Formulario estructurado que acompaña al ticket; lo define la categoría (o la subcategoría en COGNITI).
enum TicketFormType {
  SOFTWARE_REMOTE
  ACCESS_REQUEST
  STUDY_CREATE
  STUDY_UPDATE
  CLIENT_CREATE
}

model TicketSubcategory {
  id       String          @id @default(uuid())
  category Category
  name     String
  isActive Boolean         @default(true) @map("is_active")
  formType TicketFormType? @map("form_type")

  tickets Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, name])
  @@map("ticket_subcategories")
}

enum TicketEventType {
  CREATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  CATEGORY_CHANGED
  SUBCATEGORY_CHANGED
  ASSIGNED
  UNASSIGNED
  COMMENTED
  REOPENED
  FORM_UPDATED
  FORM_APPLIED
  FORM_REJECTED
}

/// What a notification is about, so the UI can show it with context.
enum TicketNotificationKind {
  COMMENT
  CHANGE
  ASSIGNMENT
  OVERDUE
  FORM
  NEW_TICKET
}

model TicketEvent {
  id   String          @id @default(uuid())
  type TicketEventType

  ticketId String @map("ticket_id")
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  actorId String @map("actor_id")
  actor   User   @relation("TicketEventActor", fields: [actorId], references: [id])

  fromValue String? @map("from_value")
  toValue   String? @map("to_value")

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
  @@index([type, createdAt])
  @@index([actorId])
  @@map("ticket_events")
}

model Ticket {
  id          String  @id @default(uuid())
  /// Folio per branch (TicketCounter): unique with branchId, not globally.
  code        Int
  title       String
  description String? @db.Text

  status   TicketStatus   @default(OPEN)
  priority TicketPriority @default(MEDIUM)
  category Category

  subcategoryId String?            @map("subcategory_id")
  subcategory   TicketSubcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)

  branchId String @map("branch_id")
  branch   Branch @relation(fields: [branchId], references: [id])

  createdById String @map("created_by_id")
  createdBy   User   @relation("TicketCreatedBy", fields: [createdById], references: [id])

  assignees TicketAssignee[]

  comments      TicketComment[]
  notifications TicketNotification[]
  events        TicketEvent[]
  form          TicketForm?

  firstResponseAt   DateTime? @map("first_response_at")
  resolvedAt        DateTime? @map("resolved_at")
  closedAt          DateTime? @map("closed_at")
  reopenedCount     Int       @default(0) @map("reopened_count")
  dueAt             DateTime? @map("due_at")
  overdueNotifiedAt DateTime? @map("overdue_notified_at")
  /// The SLA stops while the ticket is ON_HOLD: start of the current pause.
  onHoldSince       DateTime? @map("on_hold_since")
  /// Total seconds spent ON_HOLD (already added to dueAt).
  slaPausedSeconds  Int       @default(0) @map("sla_paused_seconds")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, code])
  @@index([branchId])
  @@index([createdById])
  @@index([status])
  @@index([subcategoryId])
  @@index([branchId, createdAt])
  @@index([createdById, createdAt])
  @@index([category, createdAt])
  @@index([resolvedAt])
  @@index([dueAt])
  @@map("tickets")
}

model TicketAssignee {
  id String @id @default(uuid())

  ticketId String @map("ticket_id")
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation("TicketAssigneeUser", fields: [userId], references: [id], onDelete: Cascade)

  assignedById String? @map("assigned_by_id")
  assignedBy   User?   @relation("TicketAssigneeAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  assignedAt DateTime @default(now()) @map("assigned_at")

  @@unique([ticketId, userId])
  @@index([userId])
  @@map("ticket_assignees")
}

model TicketComment {
  id         String  @id @default(uuid())
  body       String  @db.Text
  isInternal Boolean @default(false) @map("is_internal")
  isSystem   Boolean @default(false) @map("is_system")

  ticketId String @map("ticket_id")
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId String @map("author_id")
  author   User   @relation("TicketCommentAuthor", fields: [authorId], references: [id])

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([authorId])
  @@map("ticket_comments")
}

model TicketNotification {
  id      String                 @id @default(uuid())
  kind    TicketNotificationKind @default(CHANGE)
  message String                 @db.Text
  read    Boolean                @default(false)

  /// Who caused it (null: the system, e.g. an overdue SLA).
  actorId String? @map("actor_id")
  actor   User?   @relation("TicketNotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  ticketId String @map("ticket_id")
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([ticketId])
  @@index([read, createdAt])
  @@map("ticket_notifications")
}

/// Last folio used per branch; incremented atomically when a ticket is created.
model TicketCounter {
  branchId String @id @map("branch_id")
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  lastCode Int    @default(0) @map("last_code")

  @@map("ticket_counters")
}

model TicketForm {
  id            String         @id @default(uuid())
  type          TicketFormType
  /// Version of the form's data shape (see TICKET_FORM_DEFINITIONS).
  schemaVersion Int            @default(1) @map("schema_version")
  data          Json
  result        Json?

  rejectedAt      DateTime? @map("rejected_at")
  rejectedById    String?   @map("rejected_by_id")
  rejectedBy      User?     @relation("TicketFormRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  rejectionReason String?   @map("rejection_reason") @db.Text

  ticketId String @unique @map("ticket_id")
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  appliedAt   DateTime? @map("applied_at")
  appliedById String?   @map("applied_by_id")
  appliedBy   User?     @relation("TicketFormAppliedBy", fields: [appliedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, appliedAt])
  @@map("ticket_forms")
}
