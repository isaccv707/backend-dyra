model Review {
  id         Int      @id @default(autoincrement())
  fullName   String
  avatarUrl  String?
  rating     Int
  comment    String?  @db.Text
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@map("reviews")
}
