model VehicleCatalog {
  id       String  @id @default(uuid())
  name     String
  brand    String
  model    String
  isActive Boolean @default(true) @map("is_active")

  items VehicleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vehicle_catalogs")
}

model VehicleItem {
  id            String                  @id @default(uuid())
  internalCode  String                  @unique @map("internal_code")
  plateNumber   String?                 @unique @map("plate_number")
  mileage       String?
  fuelType      String?                 @map("fuel_type")
  transmission  String?
  ownershipType OwnershipType           @default(INTERNAL) @map("ownership_type")
  providerFolio String?                 @map("provider_folio")
  status        DeviceStatus            @default(AVAILABLE)
  condition     SafeguardConditionState
  notes         String?                 @db.Text

  catalogId String         @map("catalog_id")
  catalog   VehicleCatalog @relation(fields: [catalogId], references: [id])

  currentBranchId String @map("current_branch_id")
  currentBranch   Branch @relation("VehicleCurrentBranch", fields: [currentBranchId], references: [id])

  employeeId String?   @map("employee_id")
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  locationId String?   @map("location_id")
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  transferItems   VehicleTransferItem[]
  movementHistory VehicleMovementHistory[]
  safeguards      VehicleSafeguard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([catalogId])
  @@index([currentBranchId])
  @@index([employeeId])
  @@index([locationId])
  @@map("vehicle_items")
}

model VehicleTransferRequest {
  id     String         @id @default(uuid())
  status TransferStatus @default(PENDING)
  notes  String?        @db.Text

  originBranchId String @map("origin_branch_id")
  originBranch   Branch @relation("VehicleTransferOrigin", fields: [originBranchId], references: [id])

  destinationBranchId String @map("destination_branch_id")
  destinationBranch   Branch @relation("VehicleTransferDestination", fields: [destinationBranchId], references: [id])

  items VehicleTransferItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([originBranchId])
  @@index([destinationBranchId])
  @@index([status])
  @@map("vehicle_transfer_requests")
}

model VehicleTransferItem {
  id String @id @default(uuid())

  transferRequestId String                 @map("transfer_request_id")
  transferRequest   VehicleTransferRequest @relation(fields: [transferRequestId], references: [id], onDelete: Cascade)

  vehicleId String      @map("vehicle_id")
  vehicle   VehicleItem @relation(fields: [vehicleId], references: [id])

  createdAt DateTime @default(now())

  @@unique([transferRequestId, vehicleId])
  @@index([vehicleId])
  @@map("vehicle_transfer_items")
}

model VehicleMovementHistory {
  id      String       @id @default(uuid())
  type    MovementType
  details String       @db.Text

  vehicleId String      @map("vehicle_id")
  vehicle   VehicleItem @relation(fields: [vehicleId], references: [id])

  originBranchId String? @map("origin_branch_id")
  originBranch   Branch? @relation("VehicleMovementOrigin", fields: [originBranchId], references: [id])

  destinationBranchId String? @map("destination_branch_id")
  destinationBranch   Branch? @relation("VehicleMovementDestination", fields: [destinationBranchId], references: [id])

  createdAt DateTime @default(now())

  @@index([vehicleId])
  @@index([originBranchId])
  @@index([destinationBranchId])
  @@map("vehicle_movement_history")
}
