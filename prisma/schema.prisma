generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Study {
  id           String   @id @default(uuid())
  name         String
  code         String   @unique
  description  String?
  price        Decimal  @db.Decimal(10, 2)
  sampleType   String?
  deliveryTime Int?
  preparation  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updateAt     DateTime @updatedAt
}

model Banner {
  id        String          @id @default(uuid())
  placement BannerPlacement @default(HOME)
  imageUrl  String
  order     Int             @default(0)
  isActive  Boolean?        @default(true)
  startAt   DateTime?
  endAt     DateTime?

  @@index([placement, isActive, order])
}

enum BannerPlacement {
  HOME
}
