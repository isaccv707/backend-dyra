generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  branches Branch[]
}

model Role {
  id          String       @id @default(uuid())
  name        String
  description String?
  users       User[]
  permissions Permission[]
}

model Permission {
  id          String  @id @default(uuid())
  action      String  @unique
  description String?
  roles       Role[]
}

model State {
  id       Int      @id @default(autoincrement())
  name     String   @unique
  branches Branch[]

  @@map("states")
}

model Address {
  id           Int     @id @default(autoincrement())
  zipCode      String  @map("zip_code")
  extNumber    String  @map("ext_number")
  intNumber    String? @map("int_number")
  references   String? @db.Text
  street       String
  neighborhood String?
  city         String

  branch Branch?

  @@map("addresses")
}

model Branch {
  id         String  @id @default(uuid())
  name       String  @unique
  phone      String?
  email      String?
  isActive   Boolean @default(true)
  urlResults String

  stateId Int   @map("state_id")
  state   State @relation(fields: [stateId], references: [id])

  addressId Int     @unique @map("address_id")
  address   Address @relation(fields: [addressId], references: [id], onDelete: Cascade)

  priceSheets PriceSheets[]

  authors    Author[]
  banners    Banner[]
  posts      Post[]
  reviews    Review[]
  services   Service[]
  studies    Study[]
  schedules  BranchSchedule[]
  users      User[]
  quotations Quotation[]

  locations                   Location[]
  employees                   Employee[]
  deviceItems                 DeviceItem[]            @relation("DeviceCurrentBranch")
  transferRequestsOrigin      TransferRequest[]       @relation("TransferOrigin")
  transferRequestsDestination TransferRequest[]       @relation("TransferDestination")
  movementHistoryOrigin       DeviceMovementHistory[] @relation("MovementOrigin")
  movementHistoryDestination  DeviceMovementHistory[] @relation("MovementDestination")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("branches")
}

model BranchSchedule {
  id        String    @id @default(uuid())
  dayOfWeek DayOfWeek @map("day_of_week")
  openTime  String?   @map("open_time")
  closeTime String?   @map("close_time")
  isClosed  Boolean   @default(false) @map("is_closed")

  branchId String @map("branch_id")
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, dayOfWeek])
  @@map("branch_schedules")
}

model Banner {
  id             String          @id @default(uuid())
  placement      BannerPlacement @default(HOME)
  imageUrl       String          @map("image_url")
  mobileImageUrl String          @map("mobile_image_url")
  order          Int             @default(0)
  isActive       Boolean?        @default(true)
  startAt        DateTime?
  endAt          DateTime?

  branchId String @map("branch_id")
  branch   Branch @relation(fields: [branchId], references: [id])

  @@index([branchId, placement, isActive, order])
  @@map("banners")
}

model Service {
  id             String  @id @default(uuid())
  name           String
  slug           String
  description    String?
  icon           String?
  imageUrl       String  @map("image_url")
  mobileImageUrl String? @map("mobile_image_url")
  isActive       Boolean @default(true)

  studies Study[]

  benefits Benefit[]
  details  ServiceDetail[]

  branchId String @map("branch_id")
  branch   Branch @relation(fields: [branchId], references: [id])

  // Hoja de precios pública de este servicio (opcional). Relación 1 a 1:
  // solo un servicio puede tener vinculada una hoja dada como su pública.
  // La hoja referenciada debe tener isPublic = true y pertenecer a la
  // misma branchId — validado en services.service.ts, no a nivel DB.
  priceSheetId String?      @unique @map("price_sheet_id")
  priceSheet   PriceSheets? @relation(fields: [priceSheetId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, name])
  @@unique([branchId, slug])
  @@index([branchId])
  @@map("services")
}

model ServiceDetail {
  id          String  @id @default(uuid())
  title       String
  description String?
  image       String?
  imageMobile String?

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("service_details")
}

model Benefit {
  id          String  @id @default(uuid())
  title       String
  description String? @db.Text
  icon        String?
  serviceId   String

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("benefits")
}

model PriceSheets {
  id                 String              @id @default(uuid())
  name               String
  description        String
  isActive           Boolean             @default(true)
  isPublic           Boolean             @default(false) @map("is_public")
  studyOnPriceSheets StudyOnPriceSheet[]
  quotations         Quotation[]
  publicForService   Service?

  branchId String @map("branch_id")
  branch   Branch @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@map("price_sheets")
}

model StudyOnPriceSheet {
  id        String  @id @default(uuid())
  price     Decimal @db.Decimal(10, 2)
  showPrice Boolean @default(true)
  studyId   String
  study     Study   @relation(fields: [studyId], references: [id])

  priceSheetId String
  priceSheet   PriceSheets @relation(fields: [priceSheetId], references: [id])

  @@unique([studyId, priceSheetId])
  @@index([priceSheetId])
  @@map("study_on_price_list")
}

model Study {
  id           String  @id @default(uuid())
  name         String
  slug         String
  code         String
  description  String?
  sampleType   String?
  deliveryTime Int?
  preparation  String?
  isActive     Boolean @default(true)

  branchId String @map("branch_id")
  branch   Branch @relation(fields: [branchId], references: [id])

  priceSheets StudyOnPriceSheet[]
  serviceId   String
  service     Service             @relation(fields: [serviceId], references: [id])

  quotationItems QuotationItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, code])
  @@unique([branchId, slug])
  @@index([branchId])
  @@map("studies")
}

model Author {
  id      String  @id @default(uuid())
  name    String
  nameKey String
  avatar  String?
  bio     String?

  branchId String @map("branch_id")
  branch   Branch @relation(fields: [branchId], references: [id])

  posts Post[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, name])
  @@unique([branchId, nameKey])
  @@index([branchId])
  @@map("authors")
}

model Post {
  id              String         @id @default(uuid())
  title           String
  slug            String
  description     String
  excerpt         String
  image           String?
  imageMobile     String?
  readingTime     Int?
  metaDescription String?
  tags            String[]
  category        String
  status          PostStatus     @default(DRAFT)
  contentBlocks   ContentBlock[]
  authorId        String?

  author Author? @relation(fields: [authorId], references: [id])

  branchId String @map("branch_id")
  branch   Branch @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, slug])
  @@index([branchId])
  @@map("posts")
}

model ContentBlock {
  id      String    @id @default(uuid())
  type    BlockType
  order   Int
  content String?
  src     String?
  alt     String?

  postId String
  post   Post   @relation(fields: [postId], references: [id])

  @@map("content_blocks")
}

model Review {
  id         Int      @id @default(autoincrement())
  fullName   String
  avatarUrl  String?
  rating     Int
  comment    String?  @db.Text
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@map("reviews")
}

enum BannerPlacement {
  HOME
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum BlockType {
  PARAGRAPH
  LIST
  SUBTITLE
  QUOTE
  IMAGE
}

model Quotation {
  id          String  @id @default(uuid())
  folio       String  @unique
  clientType  String  @map("client_type")
  name        String
  lastName    String? @map("last_name")
  phoneNumber String  @map("phone_number")
  email       String?

  subtotal Decimal @db.Decimal(10, 2)
  tax      Decimal @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  priceSheetId String
  priceSheet   PriceSheets @relation(fields: [priceSheetId], references: [id])

  items QuotationItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([priceSheetId])
  @@map("quotations")
}

model QuotationItem {
  id       String  @id @default(uuid())
  name     String
  code     String?
  price    Decimal @db.Decimal(10, 2)
  quantity Int

  studyId String?
  study   Study?  @relation(fields: [studyId], references: [id], onDelete: SetNull)

  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quotation_items")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  otp       String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

enum DeviceType {
  COMPUTER
  MONITOR
  KEYBOARD
  MOUSE
  MOBILE
}

enum OwnershipType {
  INTERNAL
  PROVIDER
}

enum DeviceStatus {
  AVAILABLE
  ASSIGNED
  IN_TRANSFER
  MAINTENANCE
  RETIRED_DISPOSED
  LOST
}

enum DeviceCondition {
  NEW
  GOOD
  FAIR
  DAMAGED
}

enum TransferStatus {
  PENDING
  IN_TRANSIT
  COMPLETED
  CANCELLED
  REJECTED
}

enum MovementType {
  ENTRY_PURCHASE
  TRANSFER_OUT
  TRANSFER_IN
  ASSIGNMENT
  UNASSIGNMENT
  MAINTENANCE
  DISPOSAL
}

model Location {
  id   String @id @default(uuid())
  name String

  branchId String @map("branch_id")
  branch   Branch @relation(fields: [branchId], references: [id])

  devices DeviceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, name])
  @@index([branchId])
  @@map("locations")
}

model Employee {
  id                      String  @id @default(uuid())
  name                    String
  department              String
  hasSignedResponsibility Boolean @default(false) @map("has_signed_responsibility")

  branchId String @map("branch_id")
  branch   Branch @relation(fields: [branchId], references: [id])

  devices DeviceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@map("employees")
}

model DeviceCatalog {
  id    String     @id @default(uuid())
  name  String
  type  DeviceType
  brand String
  model String

  items DeviceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("device_catalogs")
}

model DeviceItem {
  id            String          @id @default(uuid())
  internalCode  String          @unique @map("internal_code")
  serialNumber  String?         @unique @map("serial_number")
  ownershipType OwnershipType   @default(INTERNAL) @map("ownership_type")
  providerFolio String?         @map("provider_folio")
  status        DeviceStatus    @default(AVAILABLE)
  condition     DeviceCondition @default(GOOD)
  notes         String?         @db.Text

  catalogId String        @map("catalog_id")
  catalog   DeviceCatalog @relation(fields: [catalogId], references: [id])

  currentBranchId String @map("current_branch_id")
  currentBranch   Branch @relation("DeviceCurrentBranch", fields: [currentBranchId], references: [id])

  employeeId String?   @map("employee_id")
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  locationId String?   @map("location_id")
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  transferItems   TransferItem[]
  movementHistory DeviceMovementHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([catalogId])
  @@index([currentBranchId])
  @@index([employeeId])
  @@index([locationId])
  @@map("device_items")
}

model TransferRequest {
  id     String         @id @default(uuid())
  status TransferStatus @default(PENDING)
  notes  String?        @db.Text

  originBranchId String @map("origin_branch_id")
  originBranch   Branch @relation("TransferOrigin", fields: [originBranchId], references: [id])

  destinationBranchId String @map("destination_branch_id")
  destinationBranch   Branch @relation("TransferDestination", fields: [destinationBranchId], references: [id])

  items TransferItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([originBranchId])
  @@index([destinationBranchId])
  @@index([status])
  @@map("transfer_requests")
}

model TransferItem {
  id String @id @default(uuid())

  transferRequestId String          @map("transfer_request_id")
  transferRequest   TransferRequest @relation(fields: [transferRequestId], references: [id], onDelete: Cascade)

  deviceId String     @map("device_id")
  device   DeviceItem @relation(fields: [deviceId], references: [id])

  createdAt DateTime @default(now())

  @@unique([transferRequestId, deviceId])
  @@index([deviceId])
  @@map("transfer_items")
}

model DeviceMovementHistory {
  id      String       @id @default(uuid())
  type    MovementType
  details String       @db.Text

  deviceId String     @map("device_id")
  device   DeviceItem @relation(fields: [deviceId], references: [id])

  originBranchId String? @map("origin_branch_id")
  originBranch   Branch? @relation("MovementOrigin", fields: [originBranchId], references: [id])

  destinationBranchId String? @map("destination_branch_id")
  destinationBranch   Branch? @relation("MovementDestination", fields: [destinationBranchId], references: [id])

  createdAt DateTime @default(now())

  @@index([deviceId])
  @@index([originBranchId])
  @@index([destinationBranchId])
  @@map("device_movement_history")
}
