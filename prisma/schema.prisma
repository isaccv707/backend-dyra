generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Banner {
  id        String          @id @default(uuid())
  placement BannerPlacement @default(HOME)
  imageUrl  String
  order     Int             @default(0)
  isActive  Boolean?        @default(true)
  startAt   DateTime?
  endAt     DateTime?

  @@index([placement, isActive, order])
}

model Service {
  id          String  @id @default(uuid())
  name        String  @unique
  slug        String  @unique
  description String?
  imageUrl    String?
  isActive    Boolean @default(true)

  studies Study[]

  benefits Benefit[]
  details  ServiceDetail[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServiceDetail {
  id          String  @id @default(uuid())
  title       String
  description String?
  // content Content[]
  image       String?

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model Benefit {
  id          String  @id @default(uuid())
  title       String
  description String? @db.Text
  icon        String?
  serviceId   String

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model Study {
  id           String  @id @default(uuid())
  name         String
  slug         String  @unique
  code         String  @unique
  description  String?
  price        Decimal @db.Decimal(10, 2)
  sampleType   String?
  deliveryTime Int?
  preparation  String?
  isActive     Boolean @default(true)

  service   Service? @relation(fields: [serviceId], references: [id])
  serviceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Author {
  id      String  @id @default(uuid())
  name    String  @unique
  nameKey String  @unique
  avatar  String?
  bio     String?

  posts Post[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id              String         @id @default(uuid())
  title           String
  slug            String         @unique
  description     String
  excerpt         String
  image           String?
  readingTime     Int?
  metaDescription String?
  tags            String[]
  category        String
  status          PostStatus     @default(DRAFT)
  contentBlocks   ContentBlock[]
  authorId        String?

  author Author? @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContentBlock {
  id      String    @id @default(uuid())
  type    BlockType
  order   Int
  content String?
  src     String?
  alt     String?

  postId String
  post   Post   @relation(fields: [postId], references: [id])
}

enum BannerPlacement {
  HOME
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum BlockType {
  PARAGRAPH
  LIST
  SUBTITLE
  QUOTE
  IMAGE
}
