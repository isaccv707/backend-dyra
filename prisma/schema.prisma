generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  branches          Branch[]
  createdSafeguards Safeguard[] @relation("SafeguardCreatedBy")
  signedSafeguards  Safeguard[] @relation("SafeguardSignedBy")

  createdVehicleSafeguards VehicleSafeguard[] @relation("VehicleSafeguardCreatedBy")
  signedVehicleSafeguards  VehicleSafeguard[] @relation("VehicleSafeguardSignedBy")
}

model Role {
  id          String       @id @default(uuid())
  name        String
  description String?
  users       User[]
  permissions Permission[]
}

model Permission {
  id          String  @id @default(uuid())
  action      String  @unique
  description String?
  roles       Role[]
}

model State {
  id       Int      @id @default(autoincrement())
  name     String   @unique
  branches Branch[]

  @@map("states")
}

model Address {
  id           Int     @id @default(autoincrement())
  zipCode      String  @map("zip_code")
  extNumber    String  @map("ext_number")
  intNumber    String? @map("int_number")
  references   String? @db.Text
  street       String
  neighborhood String?
  city         String

  branch Branch?

  @@map("addresses")
}

model Branch {
  id         String  @id @default(uuid())
  name       String  @unique
  phone      String?
  email      String?
  isActive   Boolean @default(true)
  urlResults String

  stateId Int   @map("state_id")
  state   State @relation(fields: [stateId], references: [id])

  addressId Int     @unique @map("address_id")
  address   Address @relation(fields: [addressId], references: [id], onDelete: Cascade)

  priceSheets PriceSheets[]

  authors    Author[]
  banners    Banner[]
  posts      Post[]
  reviews    Review[]
  services   Service[]
  studies    Study[]
  schedules  BranchSchedule[]
  users      User[]
  quotations Quotation[]

  locations                   Location[]
  employees                   Employee[]
  safeguards                  Safeguard[]
  deviceItems                 DeviceItem[]            @relation("DeviceCurrentBranch")
  transferRequestsOrigin      TransferRequest[]       @relation("TransferOrigin")
  transferRequestsDestination TransferRequest[]       @relation("TransferDestination")
  movementHistoryOrigin       DeviceMovementHistory[] @relation("MovementOrigin")
  movementHistoryDestination  DeviceMovementHistory[] @relation("MovementDestination")

  vehicleItems                       VehicleItem[]             @relation("VehicleCurrentBranch")
  vehicleTransferRequestsOrigin      VehicleTransferRequest[]  @relation("VehicleTransferOrigin")
  vehicleTransferRequestsDestination VehicleTransferRequest[]  @relation("VehicleTransferDestination")
  vehicleMovementHistoryOrigin       VehicleMovementHistory[]  @relation("VehicleMovementOrigin")
  vehicleMovementHistoryDestination  VehicleMovementHistory[]  @relation("VehicleMovementDestination")
  vehicleSafeguards                  VehicleSafeguard[]        @relation("VehicleSafeguardBranch")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("branches")
}

model BranchSchedule {
  id        String    @id @default(uuid())
  dayOfWeek DayOfWeek @map("day_of_week")
  openTime  String?   @map("open_time")
  closeTime String?   @map("close_time")
  isClosed  Boolean   @default(false) @map("is_closed")

  branchId String @map("branch_id")
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, dayOfWeek])
  @@map("branch_schedules")
}

model Banner {
  id             String          @id @default(uuid())
  placement      BannerPlacement @default(HOME)
  imageUrl       String          @map("image_url")
  mobileImageUrl String          @map("mobile_image_url")
  order          Int             @default(0)
  isActive       Boolean?        @default(true)
  startAt        DateTime?
  endAt          DateTime?

  branchId String @map("branch_id")
  branch   Branch @relation(fields: [branchId], references: [id])

  @@index([branchId, placement, isActive, order])
  @@map("banners")
}

model Service {
  id             String  @id @default(uuid())
  name           String
  slug           String
  description    String?
  icon           String?
  imageUrl       String  @map("image_url")
  mobileImageUrl String? @map("mobile_image_url")
  isActive       Boolean @default(true)

  studies Study[]

  benefits Benefit[]
  details  ServiceDetail[]

  branchId String @map("branch_id")
  branch   Branch @relation(fields: [branchId], references: [id])

  // Hoja de precios pública de este servicio (opcional). Relación 1 a 1:
  // solo un servicio puede tener vinculada una hoja dada como su pública.
  // La hoja referenciada debe tener isPublic = true y pertenecer a la
  // misma branchId — validado en services.service.ts, no a nivel DB.
  priceSheetId String?      @unique @map("price_sheet_id")
  priceSheet   PriceSheets? @relation(fields: [priceSheetId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, name])
  @@unique([branchId, slug])
  @@index([branchId])
  @@map("services")
}

model ServiceDetail {
  id          String  @id @default(uuid())
  title       String
  description String?
  image       String?
  imageMobile String?

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("service_details")
}

model Benefit {
  id          String  @id @default(uuid())
  title       String
  description String? @db.Text
  icon        String?
  serviceId   String

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("benefits")
}

model PriceSheets {
  id                 String              @id @default(uuid())
  name               String
  description        String
  isActive           Boolean             @default(true)
  isPublic           Boolean             @default(false) @map("is_public")
  studyOnPriceSheets StudyOnPriceSheet[]
  quotations         Quotation[]
  publicForService   Service?

  branchId String @map("branch_id")
  branch   Branch @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@map("price_sheets")
}

model StudyOnPriceSheet {
  id        String  @id @default(uuid())
  price     Decimal @db.Decimal(10, 2)
  showPrice Boolean @default(true)
  studyId   String
  study     Study   @relation(fields: [studyId], references: [id])

  priceSheetId String
  priceSheet   PriceSheets @relation(fields: [priceSheetId], references: [id])

  @@unique([studyId, priceSheetId])
  @@index([priceSheetId])
  @@map("study_on_price_list")
}

model Study {
  id           String  @id @default(uuid())
  name         String
  slug         String
  code         String
  description  String?
  sampleType   String?
  deliveryTime Int?
  preparation  String?
  isActive     Boolean @default(true)

  branchId String @map("branch_id")
  branch   Branch @relation(fields: [branchId], references: [id])

  priceSheets StudyOnPriceSheet[]
  serviceId   String
  service     Service             @relation(fields: [serviceId], references: [id])

  quotationItems QuotationItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, code])
  @@unique([branchId, slug])
  @@index([branchId])
  @@map("studies")
}

model Author {
  id      String  @id @default(uuid())
  name    String
  nameKey String
  avatar  String?
  bio     String?

  branchId String @map("branch_id")
  branch   Branch @relation(fields: [branchId], references: [id])

  posts Post[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, name])
  @@unique([branchId, nameKey])
  @@index([branchId])
  @@map("authors")
}

model Post {
  id              String         @id @default(uuid())
  title           String
  slug            String
  description     String
  excerpt         String
  image           String?
  imageMobile     String?
  readingTime     Int?
  metaDescription String?
  tags            String[]
  category        String
  status          PostStatus     @default(DRAFT)
  contentBlocks   ContentBlock[]
  authorId        String?

  author Author? @relation(fields: [authorId], references: [id])

  branchId String @map("branch_id")
  branch   Branch @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, slug])
  @@index([branchId])
  @@map("posts")
}

model ContentBlock {
  id      String    @id @default(uuid())
  type    BlockType
  order   Int
  content String?
  src     String?
  alt     String?

  postId String
  post   Post   @relation(fields: [postId], references: [id])

  @@map("content_blocks")
}

model Review {
  id         Int      @id @default(autoincrement())
  fullName   String
  avatarUrl  String?
  rating     Int
  comment    String?  @db.Text
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@map("reviews")
}

enum BannerPlacement {
  HOME
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum BlockType {
  PARAGRAPH
  LIST
  SUBTITLE
  QUOTE
  IMAGE
}

model Quotation {
  id          String  @id @default(uuid())
  folio       String  @unique
  clientType  String  @map("client_type")
  name        String
  lastName    String? @map("last_name")
  phoneNumber String  @map("phone_number")
  email       String?

  subtotal Decimal @db.Decimal(10, 2)
  tax      Decimal @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  priceSheetId String
  priceSheet   PriceSheets @relation(fields: [priceSheetId], references: [id])

  items QuotationItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([priceSheetId])
  @@map("quotations")
}

model QuotationItem {
  id       String  @id @default(uuid())
  name     String
  code     String?
  price    Decimal @db.Decimal(10, 2)
  quantity Int

  studyId String?
  study   Study?  @relation(fields: [studyId], references: [id], onDelete: SetNull)

  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quotation_items")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  otp       String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

enum DeviceType {
  COMPUTER
  MONITOR
  KEYBOARD
  MOUSE
  MOBILE
}

enum OwnershipType {
  INTERNAL
  PROVIDER
}

enum DeviceStatus {
  AVAILABLE
  ASSIGNED
  IN_TRANSFER
  MAINTENANCE
  RETIRED_DISPOSED
  LOST
}

enum SafeguardUsageType {
  TEMPORARY
  PERMANENT
}

// Estado físico Nuevo/Seminuevo. Se captura una sola vez en DeviceItem/
// VehicleItem al dar de alta el equipo/vehículo (inventario); los detalles de
// un Safeguard/VehicleSafeguard solo copian ese mismo valor al generarse,
// nunca lo piden de nuevo.
enum SafeguardConditionState {
  NEW
  SEMINUEVO
}

// Compartido por Safeguard (IT, ya sin sección de vehículo) y por
// VehicleSafeguard — el checklist fijo del formato ADM.F.00 es el mismo.
enum SafeguardVehicleInspectionSection {
  DOCUMENTS
  BODY
}

enum TransferStatus {
  PENDING
  IN_TRANSIT
  COMPLETED
  CANCELLED
  REJECTED
}

enum MovementType {
  ENTRY_PURCHASE
  TRANSFER_OUT
  TRANSFER_IN
  ASSIGNMENT
  UNASSIGNMENT
  UNLINK
  MAINTENANCE
  DISPOSAL
}

model Location {
  id   String @id @default(uuid())
  name String

  branchId String @map("branch_id")
  branch   Branch @relation(fields: [branchId], references: [id])

  devices  DeviceItem[]
  vehicles VehicleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, name])
  @@index([branchId])
  @@map("locations")
}

model Employee {
  id                      String  @id @default(uuid())
  name                    String
  position                String?
  department              String
  hasSignedResponsibility Boolean @default(false) @map("has_signed_responsibility")
  // Archivado en vez de borrado: un empleado dado de baja (offboard) nunca se
  // puede eliminar por integridad referencial en cuanto tiene resguardos
  // (vigentes o históricos), así que isActive=false lo saca del listado sin
  // perder su historial — ver EmployeesService.offboard().
  isActive                Boolean @default(true) @map("is_active")

  branchId String @map("branch_id")
  branch   Branch @relation(fields: [branchId], references: [id])

  devices    DeviceItem[]
  safeguards Safeguard[]

  vehicles          VehicleItem[]
  vehicleSafeguards VehicleSafeguard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@map("employees")
}

model DeviceCatalog {
  id    String     @id @default(uuid())
  name  String
  type  DeviceType
  brand String
  model String
  // Archivado en vez de borrado: un modelo con equipos dados de alta (incluso
  // retirados) nunca se puede eliminar por integridad referencial, así que
  // isActive=false es la forma de sacarlo del listado sin perder el historial
  // de los DeviceItem que lo referencian.
  isActive Boolean @default(true) @map("is_active")

  items DeviceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("device_catalogs")
}

model DeviceItem {
  id            String                  @id @default(uuid())
  internalCode  String                  @unique @map("internal_code")
  // Serie del equipo; para MOBILE se usa como IMEI (mismo campo, sin
  // duplicar columna — ver SafeguardsService.buildMobileSection).
  serialNumber  String?                 @unique @map("serial_number")
  ownershipType OwnershipType           @default(INTERNAL) @map("ownership_type")
  providerFolio String?                 @map("provider_folio")
  status        DeviceStatus            @default(AVAILABLE)
  // Estado físico del equipo, obligatorio para todo DeviceItem. Se captura
  // una sola vez al dar de alta (o se corrige por PATCH); SafeguardsService
  // lo copia tal cual al generar/regenerar un safeguard, nunca se vuelve a
  // pedir en assign().
  condition     SafeguardConditionState
  notes         String?                 @db.Text

  // Solo aplica cuando catalog.type = COMPUTER (validado en DevicesService).
  hardDrive String? @map("hard_drive")
  processor String?

  // Solo aplica cuando catalog.type = MOBILE (validado en DevicesService).
  phoneNumber String? @map("phone_number")

  catalogId String        @map("catalog_id")
  catalog   DeviceCatalog @relation(fields: [catalogId], references: [id])

  currentBranchId String @map("current_branch_id")
  currentBranch   Branch @relation("DeviceCurrentBranch", fields: [currentBranchId], references: [id])

  employeeId String?   @map("employee_id")
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  locationId String?   @map("location_id")
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  // Solo aplica cuando catalog.type es MONITOR/KEYBOARD/MOUSE, y solo puede
  // apuntar a una DeviceItem con catalog.type = COMPUTER (validado en
  // DevicesService, no a nivel DB). employeeId/locationId/status/
  // currentBranchId de un accesorio SIEMPRE se derivan de su mainDevice —
  // nunca se asignan de forma independiente (ver DevicesService.assign()/
  // unassign()/retire()/receiveTransfer(), que hacen cascade a accessories).
  mainDeviceId String?      @map("main_device_id")
  mainDevice   DeviceItem?  @relation("DeviceAccessories", fields: [mainDeviceId], references: [id], onDelete: SetNull)
  accessories  DeviceItem[] @relation("DeviceAccessories")

  transferItems     TransferItem[]
  movementHistory   DeviceMovementHistory[]
  safeguardComputer SafeguardComputerDetail[]
  safeguardMobile   SafeguardMobileDetail[]
  accessoryDetails  SafeguardAccessoryDetail[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([catalogId])
  @@index([currentBranchId])
  @@index([employeeId])
  @@index([locationId])
  @@index([mainDeviceId])
  @@map("device_items")
}


model TransferRequest {
  id     String         @id @default(uuid())
  status TransferStatus @default(PENDING)
  notes  String?        @db.Text

  originBranchId String @map("origin_branch_id")
  originBranch   Branch @relation("TransferOrigin", fields: [originBranchId], references: [id])

  destinationBranchId String @map("destination_branch_id")
  destinationBranch   Branch @relation("TransferDestination", fields: [destinationBranchId], references: [id])

  items TransferItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([originBranchId])
  @@index([destinationBranchId])
  @@index([status])
  @@map("transfer_requests")
}

model TransferItem {
  id String @id @default(uuid())

  transferRequestId String          @map("transfer_request_id")
  transferRequest   TransferRequest @relation(fields: [transferRequestId], references: [id], onDelete: Cascade)

  deviceId String     @map("device_id")
  device   DeviceItem @relation(fields: [deviceId], references: [id])

  createdAt DateTime @default(now())

  @@unique([transferRequestId, deviceId])
  @@index([deviceId])
  @@map("transfer_items")
}

model DeviceMovementHistory {
  id      String       @id @default(uuid())
  type    MovementType
  details String       @db.Text

  deviceId String     @map("device_id")
  device   DeviceItem @relation(fields: [deviceId], references: [id])

  originBranchId String? @map("origin_branch_id")
  originBranch   Branch? @relation("MovementOrigin", fields: [originBranchId], references: [id])

  destinationBranchId String? @map("destination_branch_id")
  destinationBranch   Branch? @relation("MovementDestination", fields: [destinationBranchId], references: [id])

  createdAt DateTime @default(now())

  @@index([deviceId])
  @@index([originBranchId])
  @@index([destinationBranchId])
  @@map("device_movement_history")
}

// Un empleado puede tener varias filas de Safeguard a lo largo del tiempo:
// employeeId ya NO es @unique. En cualquier momento hay a lo más UNA vigente
// por empleado (supersededAt: null) — SafeguardsService.createFromEmployeeDevices
// nunca sobrescribe esa fila, la marca supersededAt y crea una nueva, así el
// contenido exacto que se pudo haber firmado antes queda intacto como
// historial.
model Safeguard {
  id String @id @default(uuid())

  employeeId String   @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id])

  branchId String @map("branch_id")
  branch   Branch @relation(fields: [branchId], references: [id])

  // Snapshot del momento en que se generó esta versión — no sigue en vivo el
  // nombre/puesto/área del empleado.
  employeeName String  @map("employee_name")
  position     String?
  area         String

  usageType SafeguardUsageType @map("usage_type")
  startDate DateTime?          @map("start_date")
  endDate   DateTime?          @map("end_date")

  createdByUserId String? @map("created_by_user_id")
  createdByUser   User?   @relation("SafeguardCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  // null = esta es la versión vigente del resguardo del empleado. Se marca
  // con la fecha en que se generó la siguiente versión (o en que se cerró
  // por offboarding, ver EmployeesService.offboard) — la fila y sus secciones
  // nunca se tocan después de eso, quedan como evidencia histórica.
  supersededAt DateTime? @map("superseded_at")

  // Firma física/evidencia de esta versión específica del documento — se
  // resetea (signedAt: null) cada vez que se genera una versión nueva, nunca
  // se hereda de la anterior. signedDocumentPublicId es el public_id de
  // Cloudinary (type: authenticated, resource_type: raw) del PDF firmado
  // escaneado; puede quedar null si la firma se confirmó manualmente sin
  // adjuntar documento.
  signedAt               DateTime? @map("signed_at")
  signedByUserId         String?   @map("signed_by_user_id")
  signedByUser           User?     @relation("SafeguardSignedBy", fields: [signedByUserId], references: [id], onDelete: SetNull)
  signedDocumentPublicId String?   @map("signed_document_public_id")

  computer SafeguardComputerDetail?
  mobile   SafeguardMobileDetail?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([createdByUserId])
  @@index([employeeId, supersededAt])
  @@map("safeguards")
}

model SafeguardComputerDetail {
  id String @id @default(uuid())

  safeguardId String    @unique @map("safeguard_id")
  safeguard   Safeguard @relation(fields: [safeguardId], references: [id], onDelete: Cascade)

  // El equipo puede reaparecer en varios safeguards a lo largo del tiempo
  // (reasignaciones), por eso la relación es 1:N desde DeviceItem.
  deviceId String     @map("device_id")
  device   DeviceItem @relation(fields: [deviceId], references: [id])

  brand        String
  model        String
  serialNumber String? @map("serial_number")
  internalCode String? @map("internal_code")
  hardDrive    String? @map("hard_drive")
  processor    String?

  condition    SafeguardConditionState
  observations String?                 @db.Text

  accessoryDetails SafeguardAccessoryDetail[]

  @@index([deviceId])
  @@map("safeguard_computer_details")
}

model SafeguardMobileDetail {
  id String @id @default(uuid())

  safeguardId String    @unique @map("safeguard_id")
  safeguard   Safeguard @relation(fields: [safeguardId], references: [id], onDelete: Cascade)

  deviceId String     @map("device_id")
  device   DeviceItem @relation(fields: [deviceId], references: [id])

  brand       String
  model       String
  imei        String?
  phoneNumber String? @map("phone_number")

  condition    SafeguardConditionState
  observations String?                 @db.Text

  accessoryDetails SafeguardAccessoryDetail[]

  @@index([deviceId])
  @@map("safeguard_mobile_details")
}

// Fila de "Accesorios incluidos" (sección computer o mobile de un safeguard).
// deviceId presente = accesorio rastreado en inventario (monitor/teclado/mouse,
// con marca/modelo/serie/código propios). deviceId null = accesorio sin
// identificador propio (p.ej. cargador de celular), solo un nombre libre.
model SafeguardAccessoryDetail {
  id String @id @default(uuid())

  computerDetailId String?                  @map("computer_detail_id")
  computerDetail   SafeguardComputerDetail?  @relation(fields: [computerDetailId], references: [id], onDelete: Cascade)

  mobileDetailId String?                @map("mobile_detail_id")
  mobileDetail   SafeguardMobileDetail? @relation(fields: [mobileDetailId], references: [id], onDelete: Cascade)

  deviceId String?     @map("device_id")
  device   DeviceItem? @relation(fields: [deviceId], references: [id])

  name         String
  brand        String?
  model        String?
  serialNumber String? @map("serial_number")
  internalCode String? @map("internal_code")

  @@index([computerDetailId])
  @@index([mobileDetailId])
  @@index([deviceId])
  @@map("safeguard_accessory_details")
}

// ============================================================================
// Vehículos — módulo independiente de devices/safeguards (administrado por
// un equipo distinto a IT). Mismo patrón de negocio (catálogo + unidades +
// traspasos + resguardo con historial/firma), pero completamente desacoplado:
// su propio catálogo, su propio ciclo de vida de asignación, y su propio
// documento de resguardo (VehicleSafeguard), nunca combinado con el de IT.
// ============================================================================

model VehicleCatalog {
  id    String @id @default(uuid())
  name  String
  brand String
  model String
  // Archivado en vez de borrado — mismo patrón que DeviceCatalog.isActive.
  isActive Boolean @default(true) @map("is_active")

  items VehicleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vehicle_catalogs")
}

model VehicleItem {
  id            String                  @id @default(uuid())
  internalCode  String                  @unique @map("internal_code")
  plateNumber   String?                 @unique @map("plate_number")
  mileage       String?
  fuelType      String?                 @map("fuel_type")
  transmission  String?
  ownershipType OwnershipType           @default(INTERNAL) @map("ownership_type")
  providerFolio String?                 @map("provider_folio")
  status        DeviceStatus            @default(AVAILABLE)
  condition     SafeguardConditionState
  notes         String?                 @db.Text

  catalogId String         @map("catalog_id")
  catalog   VehicleCatalog @relation(fields: [catalogId], references: [id])

  currentBranchId String @map("current_branch_id")
  currentBranch   Branch @relation("VehicleCurrentBranch", fields: [currentBranchId], references: [id])

  employeeId String?   @map("employee_id")
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  locationId String?   @map("location_id")
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  transferItems   VehicleTransferItem[]
  movementHistory VehicleMovementHistory[]
  safeguards      VehicleSafeguard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([catalogId])
  @@index([currentBranchId])
  @@index([employeeId])
  @@index([locationId])
  @@map("vehicle_items")
}

model VehicleTransferRequest {
  id     String         @id @default(uuid())
  status TransferStatus @default(PENDING)
  notes  String?        @db.Text

  originBranchId String @map("origin_branch_id")
  originBranch   Branch @relation("VehicleTransferOrigin", fields: [originBranchId], references: [id])

  destinationBranchId String @map("destination_branch_id")
  destinationBranch   Branch @relation("VehicleTransferDestination", fields: [destinationBranchId], references: [id])

  items VehicleTransferItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([originBranchId])
  @@index([destinationBranchId])
  @@index([status])
  @@map("vehicle_transfer_requests")
}

model VehicleTransferItem {
  id String @id @default(uuid())

  transferRequestId String                 @map("transfer_request_id")
  transferRequest   VehicleTransferRequest @relation(fields: [transferRequestId], references: [id], onDelete: Cascade)

  vehicleId String      @map("vehicle_id")
  vehicle   VehicleItem @relation(fields: [vehicleId], references: [id])

  createdAt DateTime @default(now())

  @@unique([transferRequestId, vehicleId])
  @@index([vehicleId])
  @@map("vehicle_transfer_items")
}

model VehicleMovementHistory {
  id      String       @id @default(uuid())
  type    MovementType
  details String       @db.Text

  vehicleId String      @map("vehicle_id")
  vehicle   VehicleItem @relation(fields: [vehicleId], references: [id])

  originBranchId String? @map("origin_branch_id")
  originBranch   Branch? @relation("VehicleMovementOrigin", fields: [originBranchId], references: [id])

  destinationBranchId String? @map("destination_branch_id")
  destinationBranch   Branch? @relation("VehicleMovementDestination", fields: [destinationBranchId], references: [id])

  createdAt DateTime @default(now())

  @@index([vehicleId])
  @@index([originBranchId])
  @@index([destinationBranchId])
  @@map("vehicle_movement_history")
}

// Documento de resguardo de vehículo — independiente de Safeguard (IT). Nace
// ya con historial de versiones (supersededAt) y firma con evidencia
// (signedAt/signedByUserId/signedDocumentPublicId vía Cloudinary), mismo
// patrón que Safeguard: employeeId ya no es @unique, a lo más una fila por
// empleado tiene supersededAt: null (la vigente) en un momento dado.
model VehicleSafeguard {
  id String @id @default(uuid())

  employeeId String   @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id])

  vehicleId String      @map("vehicle_id")
  vehicle   VehicleItem @relation(fields: [vehicleId], references: [id])

  branchId String @map("branch_id")
  branch   Branch @relation("VehicleSafeguardBranch", fields: [branchId], references: [id])

  // Snapshot del momento en que se generó esta versión.
  employeeName String  @map("employee_name")
  position     String?
  area         String

  // Snapshot del vehículo en ese momento (se lee en vivo de VehicleItem al
  // generar/regenerar, igual que Safeguard hace con DeviceItem).
  brand        String
  model        String
  mileage      String?
  plateNumber  String? @map("plate_number")
  fuelType     String? @map("fuel_type")
  transmission String?
  condition    SafeguardConditionState

  usageType SafeguardUsageType @map("usage_type")
  startDate DateTime?          @map("start_date")
  endDate   DateTime?          @map("end_date")

  createdByUserId String? @map("created_by_user_id")
  createdByUser   User?   @relation("VehicleSafeguardCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  supersededAt DateTime? @map("superseded_at")

  signedAt               DateTime? @map("signed_at")
  signedByUserId         String?   @map("signed_by_user_id")
  signedByUser           User?     @relation("VehicleSafeguardSignedBy", fields: [signedByUserId], references: [id], onDelete: SetNull)
  signedDocumentPublicId String?   @map("signed_document_public_id")

  inspectionItems VehicleSafeguardInspectionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([vehicleId])
  @@index([employeeId, supersededAt])
  @@map("vehicle_safeguards")
}

model VehicleSafeguardInspectionItem {
  id String @id @default(uuid())

  vehicleSafeguardId String           @map("vehicle_safeguard_id")
  vehicleSafeguard   VehicleSafeguard @relation(fields: [vehicleSafeguardId], references: [id], onDelete: Cascade)

  section      SafeguardVehicleInspectionSection
  itemKey      String                            @map("item_key")
  state        String?
  observations String?                           @db.Text

  @@unique([vehicleSafeguardId, itemKey])
  @@map("vehicle_safeguard_inspection_items")
}
