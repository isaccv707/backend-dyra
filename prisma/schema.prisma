generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model State {
  id       Int      @id @default(autoincrement())
  name     String   @unique
  branches Branch[]

  @@map("states")
}

model Address {
  id           Int     @id @default(autoincrement())
  zipCode      String  @map("zip_code")
  extNumber    String  @map("ext_number")
  intNumber    String? @map("int_number")
  references   String? @db.Text
  street       String
  neighborhood String?
  city         String

  branch Branch?

  @@map("addresses")
}

model Branch {
  id       String  @id @default(uuid())
  name     String  @unique
  phone    String?
  email    String?
  isActive Boolean @default(true)

  // Relaciones
  stateId Int   @map("state_id")
  state   State @relation(fields: [stateId], references: [id])

  addressId Int     @unique @map("address_id")
  address   Address @relation(fields: [addressId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("branches")
}

model Banner {
  id        String          @id @default(uuid())
  placement BannerPlacement @default(HOME)
  imageUrl  String
  order     Int             @default(0)
  isActive  Boolean?        @default(true)
  startAt   DateTime?
  endAt     DateTime?

  @@index([placement, isActive, order])
  @@map("banners")
}

model Service {
  id          String  @id @default(uuid())
  name        String  @unique
  slug        String  @unique
  description String?
  imageUrl    String?
  isActive    Boolean @default(true)

  studies Study[]

  benefits Benefit[]
  details  ServiceDetail[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("services")
}

model ServiceDetail {
  id          String  @id @default(uuid())
  title       String
  description String?
  // content Content[]
  image       String?

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("service_details")
}

model Benefit {
  id          String  @id @default(uuid())
  title       String
  description String? @db.Text
  icon        String?
  serviceId   String

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("benefits")
}

model Study {
  id           String  @id @default(uuid())
  name         String
  slug         String  @unique
  code         String  @unique
  description  String?
  price        Decimal @db.Decimal(10, 2)
  sampleType   String?
  deliveryTime Int?
  preparation  String?
  isActive     Boolean @default(true)

  service   Service? @relation(fields: [serviceId], references: [id])
  serviceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("studies")
}

model Author {
  id      String  @id @default(uuid())
  name    String  @unique
  nameKey String  @unique
  avatar  String?
  bio     String?

  posts Post[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("authors")
}

model Post {
  id              String         @id @default(uuid())
  title           String
  slug            String         @unique
  description     String
  excerpt         String
  image           String?
  readingTime     Int?
  metaDescription String?
  tags            String[]
  category        String
  status          PostStatus     @default(DRAFT)
  contentBlocks   ContentBlock[]
  authorId        String?

  author Author? @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("posts")
}

model ContentBlock {
  id      String    @id @default(uuid())
  type    BlockType
  order   Int
  content String?
  src     String?
  alt     String?

  postId String
  post   Post   @relation(fields: [postId], references: [id])

  @@map("content_blocks")
}

enum BannerPlacement {
  HOME
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum BlockType {
  PARAGRAPH
  LIST
  SUBTITLE
  QUOTE
  IMAGE
}
