# Copiar a .env y completar. Nunca versionar el .env real.

# PostgreSQL (docker-compose.yaml usa DB_USER/DB_PASSWORD/DB_NAME)
DB_USER=dyra
DB_PASSWORD=change-me
DB_NAME=dyra_db
DATABASE_URL="postgresql://dyra:change-me@localhost:5432/dyra_db?schema=public"

# Servidor
PORT=3000
# Orígenes permitidos (REST y WebSocket), separados por coma: dira-astro y admin-dyra-web
CORS_ORIGINS="http://localhost:4321,http://localhost:5173"
# Base de los links en correos de tickets (opcional, default https://admin.dyranalitica.com)
ADMIN_APP_URL="http://localhost:5173"

# Auth
JWT_SECRET=change-me-long-random-string
JWT_EXPIRES_IN=7d

# Seed (npx prisma db seed)
ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me
# Solo desarrollo: crea la sucursal por defecto (a1b2c3d4-0001-4000-8000-000000000001).
# Nunca activarlo contra producción; se ignora si NODE_ENV=production.
SEED_DEV_BRANCH=true

# Correo (Gmail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# Cloudinary (documentos firmados de resguardos). El API secret solo vive aquí.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis (requerido): cola de correos (BullMQ) y Socket.IO entre instancias.
# docker compose levanta redis en 6379.
REDIS_URL="redis://localhost:6379"

# Requerido: cifra las contraseñas de TeamViewer de los tickets (32 bytes en base64).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si se pierde o cambia, las contraseñas guardadas ya no se pueden leer.
TICKET_SECRET_KEY=

# Ciclo de vida de tickets (opcional): cierre automático de RESOLVED tras N
# días hábiles sin respuesta, y escalamiento al Administrador tras N horas
# hábiles vencido sin asignar.
# TICKET_AUTO_CLOSE_DAYS=3
# TICKET_ESCALATION_HOURS=2

# Reverse proxy hops to trust for the client IP (rate limits). 1 behind Railway; empty locally.
TRUST_PROXY=
